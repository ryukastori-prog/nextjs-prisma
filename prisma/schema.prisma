// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("MANGASYNC_DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  createdAt    DateTime  @default(now())
  episodes     Episode[]
  sessions     Session[]
  characters   Character[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Episode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  status    String    @default("執筆中")
  position  Int       @default(0)
  outline   String    @default("")
  createdAt DateTime  @default(now())
  versions  Version[]

  outlineVersions OutlineVersion[]

  @@index([userId])
}

model Version {
  id        String   @id @default(uuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  number    Int
  note      String
  text      String
  createdAt DateTime @default(now())

  @@unique([episodeId, number])
}

model OutlineVersion {
  id        String   @id @default(uuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  number    Int
  note      String
  data      String
  createdAt DateTime @default(now())

  @@unique([episodeId, number])
}

model Character {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  role        String   @default("")
  personality String   @default("")
  appearance  String   @default("")
  memo        String   @default("")
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId])
}
